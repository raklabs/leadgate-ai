# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/lead_qualifier.db

# Security & Authentication (Generate strong random values in production)
API_KEY=dev-internal-api-key-change-me-in-prod-32chars
WEBHOOK_SECRET=dev-webhook-hmac-secret-change-me-in-prod
REQUIRE_WEBHOOK_SIGNATURE=false
DEDUP_WINDOW_HOURS=24
MAX_PAYLOAD_BYTES=65536

# AI Provider Configuration (ollama | openai | openai_compatible | anthropic | deterministic_local)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct

# Cloud / OpenAI-Compatible Providers (OpenAI, Groq, Together, OpenRouter, vLLM, LM Studio)
OPENAI_API_KEY=sk-proj-your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=3

# CRM Integration Configuration (mock | hubspot | gohighlevel)
CRM_PROVIDER=mock
CRM_API_KEY=pat-na1-your-crm-private-app-token
CRM_BASE_URL=https://api.hubapi.com
CRM_TIMEOUT_SECONDS=10.0
CRM_MAX_RETRIES=3

# Scoring Rules Configuration Path
SCORING_RULES_PATH=config/scoring_rules.yaml

